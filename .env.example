# Application Environment Variables
DATABASE_URL="postgresql://user:password@localhost:5432/instaflow_crm?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-with: openssl rand -hex 32"
ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# Meta / Instagram Platform API Integration
INSTAGRAM_APP_ID="your_meta_app_id"
INSTAGRAM_APP_SECRET="your_meta_app_secret"
# Facebook Login for Business configuration ID (Instagram > API setup with unified login)
INSTAGRAM_CONFIG_ID="your_facebook_login_for_business_config_id"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/v1/integrations/instagram/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your_secure_webhook_verify_token"
META_GRAPH_API_VERSION="v27.0"

# AI Automation Providers (Gemini / OpenAI compatible)
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# File storage: AWS S3 (private bucket). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="instaflow-attachments"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"

# App URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PORT="3000"

# Registering with this email makes the account platform super admin
SUPER_ADMIN_EMAIL=""

# Email (Resend: https://resend.com/api-keys). Without a key, emails are printed to the server log.
RESEND_API_KEY=""
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="Flowza <onboarding@resend.dev>"
